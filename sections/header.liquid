

{% assign settings = section.settings  %}


{% comment %}
navbar
{% endcomment %}
<div class="header container d-flex justify-content-between align-items-center">
<h4>{{settings.logo}}</h4>
<p class="m-0">{{settings.headerpar}}</p>
<a href ="{{settings.buttonurl}}" class="d-flex justify-content-center align-items-center gap-2" > {{settings.buttontext}}
 <span>
<svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg>
</span> </a>

</div>

{% style %}
.header{
    margin:0;
    width:100%;
    background-color:{{settings.backgroundcolor}};
     padding:{{settings.padding}}px;
}
.header h4{
margin:0;
color:{{settings.logocolor}};
font-size:{{settings.logofontsize}}px;
text-transform:uppercase;
font-weight:700;
letter-spacing:1PX ;
}

 .header p{
  line-height: 13.42px;
  font-size:16px;
  color:black;
 }
.header a{
    border:2px solid transparent;
    text-transform:uppercase;
    background-color:#FFF544;
    color:{{settings.buttontextcolor}};
    background-color:{{settings.buttonbgcolor}};
    padding:10px 30px;
    position:relative;
    overflow:hidden;
    z-index:1;
    transition:.5s;
    

}
.header a::before{
  content:"";
  width:100%;
  height:100%;
  top:0;
  left:-100%;
 background-color:black;
 position:absolute;
z-index:-1;
transition:.5s;


}
.header a:hover{
color:white;
border:black;
fill:white;
}
.header a:hover span{
color:white;

}
.header a:hover::before{
left:0;
border:black;
}
a svg{
    color:currentColor;
}
{% endstyle %} 




{% schema %}
{
"name":"navbar",
"settings":[
{"type":"header",
"content":"navbar"},

{"type":"color",
"id":"backgroundcolor",
"label":"navbarbgcolor"
},
{"type":"range",
"id":"padding",
"label":"Padding",
"min":10,
"max":40,
"step":2,
"unit":"px",
"default":14


},
    {
"type":"header",
"content":"navbarlogo"
},
{
    "type":"text",
    "id":"logo",
    "label":"logoName",
    "default":"tisso vision"

},
{
    "type":"color",
    "id":"logocolor",
    "label":"logoColor"
},
{
"type":"range",
"id" :"logofontsize",
"label":"fontsize",
"min":16,
"max":75,
"step":1,
"unit":"px",
"default":16
},

{
"type":"header",
"content":"navbarbutton"
},

{
    "type":"text",
    "id":"buttontext",
    "label":"buttonName",
    "default":"choose gift"

},
{
    "type":"color",
    "id":"buttontextcolor",
    "label":"textbuttonColor"
},
{
    "type":"color",
    "id":"buttonbgcolor",
    "label":"buttonbgColor"
},

{
    "type":"url",
    "id":"buttonurl",
    "label":"buttonlink"
},

{"type":"range",
"id" :"buttonfontsize",
"label":"fontsize",
"min":16,
"max":75,
"step":1,
"unit":"px",
"default":16
},

{
"type":"header",
"content":"navbarpargraph"
},
{
    "type":"textarea",
    "id":"headerpar",
    "label":"navbarpar",
    "default":"Find the ideal gift for your loved ones."

},
{
    "type":"color",
    "id":"parcolor",
    "label":"addressColor"
},

{"type":"range",
"id" :"addressfontsize",
"label":"fontsize",
"min":16,
"max":75,
"step":1,
"unit":"px",
"default":40
}],
 "presets":[{
  "name":"navbar"
 }]


}
{% endschema %}
 